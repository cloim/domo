PORT=4300
DATABASE_URL=postgres://domo:domo@localhost:5434/domo
JWT_SECRET=change-me
# Google Cloud Console 웹 애플리케이션 OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=
# 로컬 개발용 이메일 로그인. 운영에서는 false
DEV_LOGIN=false
PUBLIC_URL=https://domo.example.com
WEB_DIST=../web/dist
# AI API 키 암호화용 비밀값(바꾸면 저장된 키를 다시 등록해야 함)
AI_SECRET_KEY=change-me

{
  "name": "domo",
  "private": true,
  "version": "0.4.6",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "db:up": "docker compose up -d db",
    "dev:server": "pnpm --filter @domo/server dev",
    "dev:web": "pnpm --filter @domo/web dev",
    "build": "pnpm --filter @domo/web build",
    "build:check": "pnpm --filter @domo/web typecheck && pnpm --filter @domo/web exec vite build --outDir ../../release/web-check --emptyOutDir",
    "start": "pnpm --filter @domo/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "release:android": "node scripts/release-android.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

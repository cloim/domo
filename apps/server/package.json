{
  "name": "@domo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.development src/index.ts",
    "dev:agent": "node scripts/dev-agent.mjs",
    "start": "tsx --env-file=../../.env src/index.ts",
    "start:prod": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@domo/core": "workspace:*",
    "@fastify/static": "^10.1.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11"
  }
}
